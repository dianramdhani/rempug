{
	"name": "rempug",
	"version": "0.1.4",
	"description": "Distribusi kerja dari agent orkestrator ke agent CLI lain lewat tmux, hemat token.",
	"keywords": [
		"agent",
		"orchestrator",
		"tmux",
		"mcp",
		"cli"
	],
	"license": "MIT",
	"type": "module",
	"bin": {
		"rempug": "dist/src/cli.js"
	},
	"files": [
		"dist/src",
		"skills",
		".claude-plugin",
		"hooks",
		".mcp.json",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22.13"
	},
	"os": [
		"linux",
		"darwin"
	],
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"check": "biome check .",
		"test": "npm run build && node --test \"dist/test/**/*.test.js\"",
		"prepublishOnly": "npm run build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/git": "^11.0.1",
		"@types/node": "^22.20.5",
		"semantic-release": "^25.0.9",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.32.2",
		"zod": "^4.6.7"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dianramdhani/rempug.git"
	},
	"homepage": "https://github.com/dianramdhani/rempug#readme",
	"bugs": {
		"url": "https://github.com/dianramdhani/rempug/issues"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
