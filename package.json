{
	"name": "rempug",
	"version": "0.0.0",
	"description": "Distribusi kerja dari agent orkestrator ke agent CLI lain lewat tmux, hemat token.",
	"keywords": [
		"agent",
		"orchestrator",
		"tmux",
		"mcp",
		"cli"
	],
	"license": "MIT",
	"type": "module",
	"bin": {
		"rempug": "dist/src/cli.js"
	},
	"files": [
		"dist/src",
		"skills",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22.13"
	},
	"os": [
		"linux",
		"darwin"
	],
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"check": "biome check .",
		"test": "npm run build && node --test \"dist/test/**/*.test.js\"",
		"prepublishOnly": "npm run build"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@types/node": "^22.20.5",
		"typescript": "^7.0.2"
	}
}
